# Local Postgres (docker-compose) by default. Swap for a Neon branch connection
# string (use the pooled "-pooler" host) for pre-prod checks.
DATABASE_URL=postgresql://postgres:root@localhost:5432/ithaca
APP_PORT=4001
FRONTEND_URL=http://localhost:5173

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/connected-accounts/google/callback
