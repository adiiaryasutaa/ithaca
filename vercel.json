{
    "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!AGENTS.md' ':!CLAUDE.md' ':!README.md' ':!.prettierignore' ':!.prettierrc.json' ':!.claude' ':!.vscode' ':!docs' ':!docker-compose.yml' ':!.env.docker.example' ':!.gitignore'",
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "backend": {
            "root": "backend",
            "entrypoint": "src/server.ts"
        }
    },
    "rewrites": [
        {
            "source": "/api/v1/:path*",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/api/:path*",
            "destination": {
                "type": "service",
                "service": "backend",
                "path": "/:path*"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
